@baseUrl = https://localhost:7284
@accessToken = {{token returned by login}}

### List roles
GET {{baseUrl}}/api/roles
Authorization: Bearer {{accessToken}}

### Add an order permission to Driver (roles.manage required)
PUT {{baseUrl}}/api/roles/Driver/permissions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "permission": "orders.read"
}

### Assign a role to an account (Admin only)
PUT {{baseUrl}}/api/roles/users/customer@example.com/role
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roleName": "Driver"
}
